    {
      "start": 0.0,
      "end": 1.36,
      "text": "平常你几点睡几点起"
    },
    {
      "start": 1.36,
      "end": 2.8,
      "text": "我们之前做过一个熬夜的节目"
    },
    {
      "start": 2.8,
      "end": 4.04,
      "text": "但我们再想挑战一下"
    },
    {
      "start": 4.04,
      "end": 6.24,
      "text": "如果我们两位经常熬夜的同事"
    },
    {
      "start": 6.24,
      "end": 8.32,
      "text": "现在变成晚上十点睡"
    },
    {
      "start": 8.32,
      "end": 9.64,
      "text": "早上六点起"
    },
    {
      "start": 9.64,
      "end": 10.72,
      "text": "持续二十一天"
    },
    {
      "start": 10.72,
      "end": 11.88,
      "text": "他们会发生什么"
    },
    {
      "start": 11.88,
      "end": 12.8,
      "text": "我们来试试吧"
    },
    {
      "start": 12.8,
      "end": 14.04,
      "text": "二十一天后见"
