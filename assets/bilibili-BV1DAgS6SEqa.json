    {
      "start": 153.36,
      "end": 154.36,
      "text": "好 好的"
    },
    {
      "start": 154.36,
      "end": 156.2,
      "text": "现在有点困"
    },
    {
      "start": 156.2,
      "end": 158.0,
      "text": "感觉我的成绩会很烂"
    },
    {
      "start": 158.0,
      "end": 159.44,
      "text": "蓝 红"
    },
    {
      "start": 161.52,
      "end": 165.92,
      "text": "白 黄 绿 紫 蓝"
    },
    {
      "start": 165.92,
      "end": 166.56,
      "text": "你有沒有发现"
    },
    {
      "start": 166.56,
      "end": 168.6,
      "text": "你需要非常认真才能读对它"
