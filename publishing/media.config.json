{
  "version": 1,
  "localAssetRoot": "clips/assets",
  "manifestRoot": "publishing/assets",
  "oss": {
    "bucket": "l4p-web-clips-hk",
    "region": "oss-cn-hongkong",
    "endpoint": "oss-cn-hongkong.aliyuncs.com",
    "publicBaseUrl": "https://assets.l4p.site",
    "objectPattern": "media/{sha256Prefix}/{sha256}{extension}",
    "objectAcl": "public-read",
    "headers": {
      "Content-Disposition": "inline",
      "Cache-Control": "public, max-age=31536000, immutable"
    }
  },
  "allowedMedia": {
    ".avif": "image/avif",
    ".gif": "image/gif",
    ".jpeg": "image/jpeg",
    ".jpg": "image/jpeg",
    ".png": "image/png",
    ".webp": "image/webp",
    ".mp3": "audio/mpeg",
    ".m4a": "audio/mp4",
    ".mp4": "video/mp4",
    ".webm": "video/webm",
    ".pdf": "application/pdf"
  }
}
