    {
      "start": 464.3,
      "end": 466.2,
      "text": "到一一或一二的函数"
    },
    {
      "start": 466.2,
      "end": 470.2,
      "text": "你看"
    },
    {
      "start": 470.2,
      "end": 470.9,
      "text": "这么一看的话"
    },
    {
      "start": 470.9,
      "end": 473.2,
      "text": "哪有什么四大基本元素"
