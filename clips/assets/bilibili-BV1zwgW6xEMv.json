    {
      "start": 338.0,
      "end": 338.6,
      "text": "函数"
    },
    {
      "start": 338.6,
      "end": 339.2,
      "text": "类型"
    },
    {
      "start": 339.2,
      "end": 340.6,
      "text": "流程"
    },
    {
      "start": 340.6,
      "end": 341.6,
      "text": "太棒了"
    },
    {
      "start": 341.6,
      "end": 343.2,
      "text": "就像是古希腊哲学家"
    },
    {
      "start": 343.2,
      "end": 345.4,
      "text": "第一次发现了四元素学书"
    },
    {
      "start": 345.4,
      "end": 347.0,
      "text": "发现世间万物"
