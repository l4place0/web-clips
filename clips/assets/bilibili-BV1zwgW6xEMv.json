      "start": 594.1,
      "end": 596.0,
      "text": "我认为一切皆对象"
    },
    {
      "start": 596.0,
      "end": 598.1,
      "text": "真想要叠加"
    },
    {
      "start": 598.1,
      "end": 599.1,
      "text": "你请说"
    },
    {
      "start": 599.1,
      "end": 600.4,
      "text": "我认为一切皆对象"
    },
    {
      "start": 600.4,
      "end": 601.2,
      "text": "如果我错了"
    },
    {
      "start": 601.2,
      "end": 602.4,
