    {
      "start": 603.4,
      "end": 606.1,
      "text": "我认为一切几乎皆对象"
    },
    {
      "start": 606.1,
      "end": 608.1,
      "text": "其实你打心眼底里"
    },
    {
      "start": 608.1,
      "end": 610.2,
      "text": "相信一切皆对象吗"
    },
    {
      "start": 610.2,
      "end": 611.3,
      "text": "但是你很虚伪"
    },
    {
      "start": 611.3,
      "end": 612.9,
      "text": "你表面上留有余地"
    },
    {
      "start": 612.9,
      "end": 616.3,
      "text": "实际上不肯为一切皆对象的理论单则"
