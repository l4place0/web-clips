    },
    {
      "start": 474.4,
      "end": 477.4,
      "text": "這裡可以設置Saw Rendant的最大數"
    },
    {
      "start": 477.4,
      "end": 479.4,
      "text": "默認是4"
    },
    {
      "start": 479.4,
      "end": 482.4,
